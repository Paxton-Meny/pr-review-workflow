#!/bin/sh
# Refuse direct pushes to main; every change lands through a pull request.
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
	refs/heads/main)
		echo "pre-push: refusing direct push to main; open a pull request" >&2
		status=1
		;;
	esac
done
exit "$status"
